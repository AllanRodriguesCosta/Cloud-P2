{
  "name": "cloud-p2",
  "version": "1.0.0",
  "private": true,
  "description": "P2 Cloud: copia arquivos de uma pasta do Google Drive para o contêiner Azure Blob P2_Allan_ribeiro.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.26.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
