# Copie para .env (cp .env.example .env) e preencha. NUNCA envie o .env ao GitHub.
PORT=3000
GOOGLE_DRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA
# Conteúdo do JSON da Service Account codificado em Base64 (uma linha só).
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa local: GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
AZURE_STORAGE_CONNECTION_STRING=
# O Azure só aceita minúsculas, números e hífens: o app usa "p2-allan-ribeiro" no Azure (veja o README).
AZURE_STORAGE_CONTAINER=P2_Allan_ribeiro
CORS_ORIGIN=http://localhost:5173
